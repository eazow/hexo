if (hexo-config('toc.enable')) {
  .post-toc {
    font-size: 14px;

    ol {
      list-style: none;
      margin: 0;
      padding: 0 2px 5px 10px;
      text-align: left;

      > ol {
        padding-left: 0;
      }

      a {
        color: $grey-dark;
        opacity: .75;
        transition: all $transition-ease;

        &:hover {
          opacity: 1;
        }
      }
    }

    .nav-item {
      line-height: 2.4;
      overflow: hidden;
      text-overflow: ellipsis;

      if (not hexo-config('toc.wrap')) {
        white-space: nowrap;
      }
    }

    .nav {
      .nav-child {
        display: hexo-config('toc.expand_all') ? block : none;
      }

      .active > .nav-child {
        display: block;
      }

      .active-current > .nav-child {
        display: block;

        > .nav-item {
          display: block;
        }
      }

      .active > a {
        border-bottom-color: $sidebar-highlight;
        color: $sidebar-highlight;
        opacity: 1;
      }

      .active-current > a {
        color: $sidebar-highlight;
        opacity: 1;

        &:hover {
          color: $sidebar-highlight;
        }
      }
    }
  }
}
